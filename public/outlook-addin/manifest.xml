<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>a7e4c1b2-9d3f-4e5a-8c6b-1f2e3d4c5b6a</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>NSML</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Send to WorkDesk" />
  <Description DefaultValue="Capture the open email into NSML WorkDesk for triage, evidence, cases, and reviewed drafts." />
  <IconUrl DefaultValue="https://nsml-workdesk.vercel.app/outlook-addin/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://nsml-workdesk.vercel.app/outlook-addin/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://nsml-workdesk.vercel.app/" />

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://nsml-workdesk.vercel.app/outlook-addin/taskpane.html" />
        <RequestedHeight>360</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="nsmlWorkDeskGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="nsmlCaptureButton">
                  <Label resid="captureLabel" />
                  <Supertip>
                    <Title resid="captureLabel" />
                    <Description resid="captureTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://nsml-workdesk.vercel.app/outlook-addin/assets/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://nsml-workdesk.vercel.app/outlook-addin/assets/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://nsml-workdesk.vercel.app/outlook-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://nsml-workdesk.vercel.app/outlook-addin/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="WorkDesk" />
        <bt:String id="captureLabel" DefaultValue="Send to WorkDesk" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="captureTip" DefaultValue="Capture this email into NSML WorkDesk. Reads the open message only; nothing is sent on your behalf." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
